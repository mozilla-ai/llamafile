diff --git a/src/model.cpp b/src/model.cpp
--- a/agent.cpp/src/model.cpp
+++ b/agent.cpp/src/model.cpp
@@ -1,6 +1,7 @@
 #include "model.h"
 #include "chat.h"
 #include "error.h"
+#include <nlohmann/json.hpp>
 #include <algorithm>
 #include <cstdio>
 
@@ -183,12 +184,85 @@ Model::generate(const std::vector<common_chat_msg>& messages,
 
     std::string response = generate_from_tokens(prompt_tokens, callback);
 
-    common_chat_parser_params syntax;
-    // Use explicitly configured format, or fall back to auto-detected format
-    syntax.format = config_.chat_format.value_or(params.format);
+    // Build parser params from the chat template's outputs.
+    // common_chat_parser_params(chat_params) copies format + generation_prompt;
+    // we additionally need to load the PEG arena from chat_params.parser, as
+    // llama.cpp/tools/cli/cli.cpp:94-98 and server-task.cpp:420-422 do.
+    common_chat_parser_params syntax(params);
+    if (config_.chat_format.has_value()) {
+        syntax.format = *config_.chat_format;
+    }
+    if (!params.parser.empty()) {
+        syntax.parser.load(params.parser);
+    }
     syntax.parse_tool_calls = true;
 
-    auto parsed_msg = common_chat_parse(response, false, syntax);
+    common_chat_msg parsed_msg;
+    try {
+        parsed_msg = common_chat_parse(response, /*is_partial=*/false, syntax);
+    } catch (const std::exception &e) {
+        // PEG parser refused the input. Fall back to content-only with a
+        // best-effort heuristic extractor for <tool_call>{...}</tool_call> JSON
+        // blocks that the underlying llama.cpp grammar didn't anchor to. The
+        // heuristic mirrors what llama-server does after `common_chat_parse`
+        // returns no tool_calls but the model clearly emitted a structured
+        // call; it lets the agent loop continue rather than terminating early.
+        fprintf(stderr,
+                "[agent.cpp] common_chat_parse threw (%s); falling back to "
+                "heuristic <tool_call> extraction\n",
+                e.what());
+        parsed_msg = common_chat_msg{};
+        parsed_msg.content = response;
+    }
+    // Heuristic recovery: even when PEG parses cleanly, it sometimes returns
+    // tool_calls empty because the template's grammar doesn't anchor to
+    // <tool_call>{json}</tool_call>. Scan the content for <tool_call>...</tool_call>
+    // blocks and lift them into tool_calls.
+    if (parsed_msg.tool_calls.empty()) {
+        const std::string open = "<tool_call>";
+        const std::string close = "</tool_call>";
+        std::string content_clean;
+        size_t i = 0;
+        while (i < response.size()) {
+            auto a = response.find(open, i);
+            if (a == std::string::npos) {
+                content_clean.append(response, i, std::string::npos);
+                break;
+            }
+            content_clean.append(response, i, a - i);
+            auto b = response.find(close, a + open.size());
+            if (b == std::string::npos) break;
+            std::string payload = response.substr(a + open.size(), b - (a + open.size()));
+            // Trim surrounding whitespace.
+            size_t s = payload.find_first_not_of(" \t\r\n");
+            size_t e2 = payload.find_last_not_of(" \t\r\n");
+            if (s != std::string::npos && e2 != std::string::npos) {
+                payload = payload.substr(s, e2 - s + 1);
+            }
+            try {
+                auto j = nlohmann::json::parse(payload);
+                common_chat_tool_call call;
+                call.name = j.value("name", std::string{});
+                if (j.contains("arguments")) {
+                    if (j["arguments"].is_string()) {
+                        call.arguments = j["arguments"].get<std::string>();
+                    } else {
+                        call.arguments = j["arguments"].dump();
+                    }
+                }
+                if (!call.name.empty()) {
+                    parsed_msg.tool_calls.push_back(std::move(call));
+                }
+            } catch (...) {
+                // Not JSON — leave as content.
+                content_clean.append(open).append(payload).append(close);
+            }
+            i = b + close.size();
+        }
+        if (!parsed_msg.tool_calls.empty()) {
+            parsed_msg.content = content_clean;
+        }
+    }
     parsed_msg.role = "assistant";
 
     return parsed_msg;
