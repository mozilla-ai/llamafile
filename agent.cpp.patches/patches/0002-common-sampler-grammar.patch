@@ -175,7 +178,66 @@
 
     auto params =
       common_chat_templates_apply(weights_->get_templates(), inputs);
+
+    // Re-init the sampler when the chat template provides a tool-calling
+    // grammar (or preserved tokens / triggers). This constrains generation
+    // to syntactically valid tool calls so common_chat_parse can extract
+    // them. Mirrors what llama-server does in server-task.cpp:379-476.
+    if (!params.grammar.empty() ||
+        !params.grammar_triggers.empty() ||
+        !params.preserved_tokens.empty()) {
+        common_params_sampling sp;
+        sp.temp  = config_.temp;
+        sp.top_k = config_.top_k;
+        sp.top_p = config_.top_p;
+        sp.min_p = config_.min_p;
+        sp.seed  = config_.seed;
+        sp.generation_prompt = params.generation_prompt;
+        sp.grammar = { COMMON_GRAMMAR_TYPE_TOOL_CALLS, params.grammar };
+        sp.grammar_lazy = params.grammar_lazy;
+
+        const llama_vocab* vocab = weights_->get_vocab();
 
+        // Resolve preserved-token strings to single token ids.
+        for (const auto& t : params.preserved_tokens) {
+            auto ids = common_tokenize(vocab, t,
+                                       /*add_special=*/false,
+                                       /*parse_special=*/true);
+            if (ids.size() == 1) {
+                sp.preserved_tokens.insert(ids[0]);
+            }
+        }
+
+        // Resolve WORD-type triggers: convert to TOKEN-type when the word
+        // is a single preserved token, else keep as WORD. Mirrors
+        // server-task.cpp:443-471.
+        for (const auto& t : params.grammar_triggers) {
+            if (t.type == COMMON_GRAMMAR_TRIGGER_TYPE_WORD) {
+                auto ids = common_tokenize(vocab, t.value,
+                                           /*add_special=*/false,
+                                           /*parse_special=*/true);
+                if (ids.size() == 1 &&
+                    sp.preserved_tokens.count(ids[0])) {
+                    common_grammar_trigger trig;
+                    trig.type = COMMON_GRAMMAR_TRIGGER_TYPE_TOKEN;
+                    trig.value = t.value;
+                    trig.token = ids[0];
+                    sp.grammar_triggers.push_back(std::move(trig));
+                } else {
+                    sp.grammar_triggers.push_back(t);
+                }
+            } else {
+                sp.grammar_triggers.push_back(t);
+            }
+        }
+
+        common_sampler_free(sampler_);
+        sampler_ = common_sampler_init(weights_->get_model(), sp);
+        if (sampler_ == nullptr) {
+            throw ModelError("failed to re-init common_sampler with grammar");
+        }
+    }
+
     // Tokenize the prompt
     std::vector<llama_token> prompt_tokens = tokenize(params.prompt);
     if (prompt_tokens.empty()) {
@@ -319,7 +381,11 @@
 
     llama_token new_token_id{};
     while (true) {
-        new_token_id = llama_sampler_sample(sampler_, ctx_, -1);
+        new_token_id = common_sampler_sample(sampler_, ctx_, -1);
+        // Accept the sampled token in both the sampling chain and the
+        // grammar (no-op when no grammar is active).
+        common_sampler_accept(sampler_, new_token_id,
+                              /*accept_grammar=*/true);
 
         if (llama_vocab_is_eog(vocab, new_token_id)) {
             break;
