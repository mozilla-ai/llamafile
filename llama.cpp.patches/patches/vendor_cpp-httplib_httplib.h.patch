diff --git a/vendor/cpp-httplib/httplib.h b/vendor/cpp-httplib/httplib.h
--- a/llama.cpp/vendor/cpp-httplib/httplib.h
+++ b/llama.cpp/vendor/cpp-httplib/httplib.h
