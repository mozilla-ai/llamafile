+#if defined(__COSMOPOLITAN__)
+  /* Cosmopolitan builds one binary for every host OS, so the E* values are
+     runtime symbols rather than compile-time constants and cannot be used as
+     case labels ("case value is not a constant expression"). Same mapping,
+     expressed as comparisons. */
+  if (error == ENOENT || error == ENOTDIR) {
+    return subprocess_error_not_found;
+  }
+  if (error == EACCES || error == EPERM) {
+    return subprocess_error_permission_denied;
+  }
+  if (error == EMFILE || error == ENFILE || error == ENOMEM) {
+    return subprocess_error_no_memory;
+  }
+  if (error == ENOSYS) {
+    return subprocess_error_not_supported;
+  }
+  return subprocess_error_unknown;
+#else
   switch (error) {
   case ENOENT:
   case ENOTDIR:
@@ -636,6 +655,22 @@ int subprocess_error_from_errno(int error) {
   default:
     return subprocess_error_unknown;
   }
+#endif
+}
+#endif
+
+#if defined(__COSMOPOLITAN__)
+#include <libc/dce.h> /* IsWindows(); <cosmo.h> would bring in its defer() macro */
+/* On Windows, Cosmopolitan's waitpid() reports the child's NT exit code as the
+   wait status. Cosmopolitan programs exit with (code << 8), so theirs decode as
+   usual, but a native program such as cmd.exe exits with the plain code: exit 3
+   reads as "killed by signal 3" (reported as EXIT_FAILURE) and exit 128 reads as
+   a clean exit 0. A status with its low byte set is taken as a native code. */
+static int subprocess_return_status_from_wait_status(int status) {
+  if (IsWindows()) {
+    return (status & 0xff) ? status : (status >> 8);
+  }
+  return WIFEXITED(status) ? WEXITSTATUS(status) : EXIT_FAILURE;
 }
 #endif
 
