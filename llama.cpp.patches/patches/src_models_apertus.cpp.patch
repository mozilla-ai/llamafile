diff --git a/src/models/apertus.cpp b/src/models/apertus.cpp
--- a/llama.cpp/src/models/apertus.cpp
+++ b/llama.cpp/src/models/apertus.cpp
@@ -8,6 +8,9 @@ void llama_model_apertus::load_arch_hparams(llama_model_loader & ml) {
     ml.get_key_or_arr(LLM_KV_XIELU_BETA,    hparams.xielu_beta,    hparams.n_layer());
     ml.get_key_or_arr(LLM_KV_XIELU_EPS,     hparams.xielu_eps,     hparams.n_layer());
 
+    // Apertus 1.5: the LM head covers only the text part of the vocab
+    ml.get_key(LLM_KV_VOCAB_SIZE_OUT, hparams.n_vocab_out_impl, false);
+
     switch (hparams.n_layer()) {
         case 32: type = LLM_TYPE_8B; break;
         default: type = LLM_TYPE_UNKNOWN;
@@ -17,11 +20,16 @@ void llama_model_apertus::load_arch_hparams(llama_model_loader & ml) {
 void llama_model_apertus::load_arch_tensors(llama_model_loader &) {
     LLAMA_LOAD_LOCALS;
 
+    const int64_t n_vocab_out = hparams.n_vocab_out_impl > 0 ? hparams.n_vocab_out_impl : n_vocab;
+    if (n_vocab_out > n_vocab) {
+        throw std::runtime_error("output vocab size is larger than vocab size");
+    }
+
     tok_embd = create_tensor(tn(LLM_TENSOR_TOKEN_EMBD, "weight"), { n_embd, n_vocab }, 0);
 
     // output
     output_norm = create_tensor(tn(LLM_TENSOR_OUTPUT_NORM, "weight"), { n_embd }, 0);
-    output      = create_tensor(tn(LLM_TENSOR_OUTPUT,      "weight"), { n_embd, n_vocab }, 0);
+    output      = create_tensor(tn(LLM_TENSOR_OUTPUT,      "weight"), { n_embd, n_vocab_out }, 0);
 
     for (int i = 0; i < n_layer; ++i) {
         auto & layer = layers[i];
@@ -163,6 +171,15 @@ llama_model_apertus::graph::graph(const llama_model & model, const llm_graph_par
     // lm_head
     cur = build_lora_mm(model.output, cur, model.output_s);
 
+    const int64_t n_vocab     = model.tok_embd->ne[1];
+    const int64_t n_vocab_out = model.output->ne[1];
+    if (n_vocab_out < n_vocab) {
+        // input-only tokens (image/audio codes) get -inf logits, so they are never sampled
+        ggml_tensor * neg_inf = ggml_scale_bias(ctx0, ggml_view_1d(ctx0, model.output_norm, 1, 0), 0.0f, -INFINITY);
+        neg_inf = ggml_repeat_4d(ctx0, neg_inf, n_vocab - n_vocab_out, cur->ne[1], 1, 1);
+        cur = ggml_concat(ctx0, cur, neg_inf, 0);
+    }
+
     cb(cur, "result_output", -1);
     res->t_logits = cur;
 }
