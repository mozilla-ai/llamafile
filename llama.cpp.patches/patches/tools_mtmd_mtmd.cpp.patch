+    // Apertus 1.5 tokenizes images into codes of the text vocab: the image is encoded here and
+    // added as text tokens, in the layout of Apertus1p5Processor.replace_image_token:
+    // <|img_start|>{H}*{W}<|img_token_start|>{row 0}<|img_end_of_row|>...{row H-1}<|img_end|>
+    int32_t add_media_apertus1p5(std::vector<const mtmd_bitmap *> & bitmaps) {
+        if (ctx->vocab == nullptr || ctx->apv_code0 == LLAMA_TOKEN_NULL) {
+            LOG_ERR("%s: error: Apertus 1.5 images need the text model\n", __func__);
+            return 2;
+        }
+        const int patch = clip_get_hparams(ctx->ctx_v)->patch_size;
+        for (const auto * bmp : bitmaps) {
+            if (bmp->nx <= 0 || bmp->ny <= 0) {
+                LOG_ERR("%s: error: invalid bitmap dimensions: nx = %d, ny = %d\n", __func__, bmp->nx, bmp->ny);
+                return 2;
+            }
+            clip_image_u8 img_u8;
+            img_u8.set_size({(int) bmp->nx, (int) bmp->ny}, bmp->is_placeholder());
+            img_u8.cpy_buf(bmp->get_ro_buf());
+
+            mtmd_image_preproc_out preproc = ctx->image_preproc->preprocess(img_u8);
+            GGML_ASSERT(preproc.entries.size() == 1);
+            const int gx = preproc.entries[0].nx() / patch;
+            const int gy = preproc.entries[0].ny() / patch;
+
+            // a placeholder only counts tokens
+            std::vector<int32_t> codes((size_t) gx * gy, 0);
+            if (!bmp->is_placeholder()) {
+                clip_image_f32_batch batch;
+                batch.entries.push_back(std::move(preproc.entries[0]));
+                clip_encode_params params;
+                params.imgs      = &batch;
+                params.n_threads = ctx->n_threads;
+                params.out_codes = &codes;
+                const int64_t t0 = ggml_time_ms();
+                if (!clip_encode(ctx->ctx_v, &params) || codes.size() != (size_t) gx * gy) {
+                    LOG_ERR("%s: error: failed to encode image\n", __func__);
+                    return 2;
+                }
+                LOG_INF("%s: image %dx%d encoded into %dx%d codes in %lld ms\n", __func__,
+                        bmp->nx, bmp->ny, gx, gy, (long long) (ggml_time_ms() - t0));
+            }
+
+            std::vector<llama_token> tokens;
+            tokens.reserve((size_t) (gx + 1) * gy + 16);
+            tokens.push_back(ctx->apv_tok_start);
+            const std::string grid = std::to_string(gy) + "*" + std::to_string(gx);
+            for (llama_token t : mtmd_tokenize_text_internal(ctx->vocab, grid, false, false)) {
+                tokens.push_back(t);
+            }
+            tokens.push_back(ctx->apv_tok_grid);
+            for (int y = 0; y < gy; y++) {
+                if (y > 0) {
+                    tokens.push_back(ctx->apv_tok_eol);
+                }
+                for (int x = 0; x < gx; x++) {
+                    tokens.push_back(ctx->apv_code0 + codes[(size_t) y * gx + x]);
+                }
+            }
+            tokens.push_back(ctx->apv_tok_end);
+            add_text(tokens);
+        }
+        return 0;
+    }
+
+    // same for audio: <|audio_start|>{codes}<|audio_end|>, see Apertus1p5Processor.replace_audio_token
+    int32_t add_media_apertus1p5_audio(const mtmd_bitmap & bitmap) {
+        if (ctx->vocab == nullptr || ctx->apa_code0 == LLAMA_TOKEN_NULL) {
+            LOG_ERR("%s: error: Apertus 1.5 audio needs the text model\n", __func__);
+            return 2;
+        }
+        const int hop = clip_get_hparams(ctx->ctx_a)->audio_hop_len;
+        const auto & buf = bitmap.get_ro_buf();
+        const size_t n_samples = bitmap.is_placeholder() ? (size_t) bitmap.nx : buf.size() / sizeof(float);
+        std::vector<int32_t> codes((n_samples + hop - 1) / hop, 0);
+
+        if (!bitmap.is_placeholder()) {
+            // peak normalize to -3 dBFS, like the processor
+            const float * samples = (const float *) buf.data();
+            float peak = 0.0f;
+            for (size_t i = 0; i < n_samples; i++) {
+                peak = std::max(peak, std::fabs(samples[i]));
+            }
+            const float scale = std::pow(10.0f, -3.0f / 20.0f) / std::max(peak, 1e-10f);
+            std::vector<float> wav(n_samples);
+            for (size_t i = 0; i < n_samples; i++) {
+                wav[i] = samples[i] * scale;
+            }
+
+            clip_image_f32 audio;
+            audio.set_size({(int) n_samples, 1}, false, /* is_audio */ true);
+            audio.cpy_buf(wav);
+            clip_image_f32_batch batch;
+            batch.is_audio = true;
+            batch.entries.push_back(std::move(audio));
+
+            const size_t n_codes = codes.size();
+            clip_encode_params params;
+            params.imgs      = &batch;
+            params.n_threads = ctx->n_threads;
+            params.out_codes = &codes;
+            const int64_t t0 = ggml_time_ms();
+            if (!clip_encode(ctx->ctx_a, &params) || codes.size() != n_codes) {
+                LOG_ERR("%s: error: failed to encode audio\n", __func__);
+                return 2;
+            }
+            LOG_INF("%s: %.2f s of audio encoded into %zu codes in %lld ms\n", __func__,
+                    (double) n_samples / clip_get_hparams(ctx->ctx_a)->audio_sample_rate, codes.size(), (long long) (ggml_time_ms() - t0));
+        }
+
+        std::vector<llama_token> tokens;
+        tokens.reserve(codes.size() + 2);
+        tokens.push_back(ctx->apa_tok_start);
+        for (int32_t c : codes) {
+            tokens.push_back(ctx->apa_code0 + c);
+        }
+        tokens.push_back(ctx->apa_tok_end);
+        add_text(tokens);
+        return 0;
+    }
