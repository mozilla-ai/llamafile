+// apertus 1.5: the tokenizers output codes of the text vocab, so the output embeddings are the token embeddings
+// of the text model for the chunk layout of add_media_apertus1p5() / add_media_apertus1p5_audio()
+static int32_t mtmd_encode_apertus1p5(mtmd_context * ctx, clip_ctx * ctx_clip, const clip_image_f32_batch & batch, std::vector<float> & out_embd) {
+    if (ctx->text_model == nullptr) {
+        LOG_ERR("%s: Apertus 1.5 media need the text model\n", __func__);
+        return 1;
+    }
+    std::vector<llama_token> tokens;
+    for (const auto & entry : batch.entries) {
+        clip_image_f32_batch one;
+        one.is_audio = batch.is_audio;
+        one.entries.push_back(entry);
+        std::vector<int32_t> codes;
+        clip_encode_params params;
+        params.imgs      = &one;
+        params.n_threads = ctx->n_threads;
+        params.out_codes = &codes;
+        const int64_t t0 = ggml_time_ms();
+        if (!clip_encode(ctx_clip, &params)) {
+            return 1;
+        }
+        if (batch.is_audio) {
+            const int hop = clip_get_hparams(ctx_clip)->audio_hop_len;
+            if (codes.size() != (size_t) (entry.nx() + hop - 1) / hop) {
+                LOG_ERR("%s: unexpected number of audio codes %zu\n", __func__, codes.size());
+                return 1;
+            }
+            for (int32_t c : codes) {
+                tokens.push_back(ctx->apa_code0 + c);
+            }
+            tokens.push_back(ctx->apa_tok_end);
+        } else {
+            const int patch = clip_get_hparams(ctx_clip)->patch_size;
+            const int gx = entry.nx() / patch;
+            const int gy = entry.ny() / patch;
+            if (codes.size() != (size_t) gx * gy) {
+                LOG_ERR("%s: unexpected number of image codes %zu\n", __func__, codes.size());
+                return 1;
+            }
+            for (int y = 0; y < gy; y++) {
+                for (int x = 0; x < gx; x++) {
+                    tokens.push_back(ctx->apv_code0 + codes[(size_t) y * gx + x]);
+                }
+                tokens.push_back(y + 1 < gy ? ctx->apv_tok_eol : ctx->apv_tok_end);
+            }
+        }
+        LOG_INF("%s: encoded into %zu codes in %lld ms\n", __func__, codes.size(), (long long) (ggml_time_ms() - t0));
+    }
+    const size_t n_embd = ctx->n_embd_out();
+    out_embd.resize(n_embd * tokens.size());
+    if (llama_model_get_tok_embd_rows(ctx->text_model, tokens.data(), (uint32_t) tokens.size(), out_embd.data()) != n_embd * tokens.size()) {
+        LOG_ERR("%s: failed to get the token embeddings\n", __func__);
+        return 1;
+    }
+    return 0;
+}
