 private:
+    // like lookup_token(), but with the raw token text: code tokens are typed unused and have no piece
+    llama_token find_text(const char * text) const {
+        const int n_vocab = llama_vocab_n_tokens(vocab);
+        for (llama_token i = 0; i < n_vocab; i++) {
+            if (strcmp(llama_vocab_get_text(vocab, i), text) == 0) {
+                return i;
+            }
+        }
+        throw std::runtime_error(string_format("%s: token %s not found, the text model does not match the mmproj", __func__, text));
+    }
