@@ -63,6 +63,13 @@ size_t ggml_backend_buft_get_alloc_size(ggml_backend_buffer_type_t buft, const s
     // get_alloc_size is optional, defaults to ggml_nbytes
     if (buft->iface.get_alloc_size) {
         size_t size = buft->iface.get_alloc_size(buft, tensor);
+        if (size < ggml_nbytes(tensor)) {
+            fprintf(stderr, "ALLOC SIZE MISMATCH: tensor=%s type=%d ne=[%lld,%lld,%lld,%lld] alloc_size=%zu nbytes=%zu\n",
+                    tensor->name, tensor->type,
